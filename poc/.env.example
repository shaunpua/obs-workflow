# Copy to .env (cp .env.example .env). The app loads .env by itself; no `export` needed.
# Lines marked  >>> FILL <<<  are the ONLY things you must edit. Never commit .env.
# Restart the app after editing this file.

# ---------- Local ports (chosen to avoid your other apps) ----------
# App: 8765 (set in .vscode/launch.json). Database: 55432 (docker-compose.yml). Leave as is.
DB_PORT=55432
GRAFANA_PORT=3100               # optional Grafana dashboards: http://localhost:3100
DATABASE_URL=postgresql://revobs:revobs@localhost:55432/revobs

# ---------- Made up by YOU (any text, no Meta needed) ----------
# >>> FILL <<< Type this same text into Meta -> Messenger -> Webhooks -> "Verify token".
META_VERIFY_TOKEN=change-me
# >>> FILL <<< Protects /api/* and the /admin pages. Open /admin?key=<this value>.
API_KEY=change-me

# ---------- From Meta: developers.facebook.com -> your app ----------
# >>> FILL <<< Settings -> Basic -> App ID
META_APP_ID=change-me
# >>> FILL <<< Settings -> Basic -> App secret -> Show. TREAT LIKE A PASSWORD.
META_APP_SECRET=change-me

# ---------- From your Facebook Page ----------
# >>> FILL <<< Page -> About -> Page transparency -> Page ID (numbers only)
META_PAGE_ID=change-me
# >>> FILL <<< Meta app -> Messenger -> API settings -> Generate token. Starts with EAA. TREAT LIKE A PASSWORD.
META_PAGE_TOKEN=change-me

# ---------- Optional (leave alone for now) ----------
GRAPH_VERSION=v23.0
NOTIFY=console                 # alerts print to the log. Set to telegram later (needs the two lines below)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_FRONTDESK_CHAT_ID=
# TELEGRAM_MANAGER_CHAT_ID=
# LLM_CLASSIFY=1               # milestone 2+: AI lead classification
# ANTHROPIC_API_KEY=
