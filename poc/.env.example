# Copy to .env, fill in, then:  set -a; source .env; set +a
DATABASE_URL=postgresql://revobs:revobs@localhost:5432/revobs

# From your Meta app (developers.facebook.com → your app → Settings → Basic)
META_APP_ID=
META_APP_SECRET=
# Any string you choose. You type the same one into Meta's webhook settings.
META_VERIFY_TOKEN=change-me

# Your Facebook Page
META_PAGE_ID=
META_PAGE_TOKEN=        # Page access token (Messenger settings → Generate token)

# Used by the /api endpoints (events, tick)
API_KEY=change-me-too
