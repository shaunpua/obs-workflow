     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT date_trunc('hour', sent_at) AS time, count(*) FILTER (WHERE direction='in') AS \"customer\", count(*) FILTER (WHERE direction='out') AS \"staff\" FROM messages WHERE $__timeFilter(sent_at) GROUP BY 1 ORDER BY 1"
