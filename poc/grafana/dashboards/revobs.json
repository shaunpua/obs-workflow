  {
   "id": 9,
   "type": "table",
   "title": "Leads",
   "description": "Copy a lead_id into the Lead dropdown at the top to see its trace below.",
   "datasource": {
    "type": "postgres",
    "uid": "revobs-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "revobs-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COALESCE(display_name, external_user_id) AS who, client_id, channel, stage, temperature, score, intent, awaiting_reply AS waiting, waiting_since, next_action, lead_id FROM leads ORDER BY updated_at DESC LIMIT 100"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Trace for selected lead",
   "description": "",
   "datasource": {
    "type": "postgres",
    "uid": "revobs-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "revobs-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT at, kind, actor, round(extract(epoch FROM at - lag(at) OVER (ORDER BY at, kind))/60, 1) AS \"min since previous\", value, detail FROM (\n  SELECT sent_at AS at, CASE WHEN direction='in' THEN 'customer_message' ELSE actor || '_reply' END AS kind, actor, NULL::numeric AS value, body AS detail FROM messages WHERE lead_id = '$lead'::uuid\n  UNION ALL SELECT occurred_at, event_type, actor, value, props::text FROM events WHERE lead_id = '$lead'::uuid) t ORDER BY at, kind"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": []
   }
  },
  {
