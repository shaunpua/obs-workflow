     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT day::timestamptz AS time, client_id AS metric, frt_p50_min AS \"p50 raw\", frt_p90_min AS \"p90 raw\", frt_p50_business_min AS \"p50 in hours\" FROM v_daily_kpis WHERE $__timeFilter(day::timestamptz) ORDER BY 1"
