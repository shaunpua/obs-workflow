     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT m.sent_at, m.client_id, COALESCE(l.display_name, l.external_user_id) AS who, m.direction, m.actor, m.body, m.app_id FROM messages m JOIN leads l USING (lead_id) ORDER BY m.sent_at DESC LIMIT 100"
